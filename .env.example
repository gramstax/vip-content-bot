# VIP Content Bot — environment template.
# Copy to `.env` and fill the required values. Never commit a real `.env`.

# ── Telegram (REQUIRED) ──────────────────────────────────────────────
# Talk to @BotFather, paste the token. Revoked/bad tokens fail at boot (401).
TELEGRAM_BOT_TOKEN=
# polling | webhook:<public-url> | serverless:<adapter>
TELEGRAM_BOT_DEPLOY=polling

# ── Sessions, paths & admins ─────────────────────────────────────────
# memory (single instance) or redis:<url> (multi-instance).
TELEGRAM_CACHE_SESSION=memory
# Log file directory (used when file logging is enabled).
LOGS_DIR=./logs
# LMDB storage directory (created at runtime, never commit).
DB_PATH=./data
# JSON array of NUMERIC admin Telegram user IDs (numbers, not strings).
# Only these users can upload content and open /admin.
BOT_ADMIN_IDS=[]
# Project-root .env — the bot rewrites gate state here, no restart needed.
GATE_ENV_PATH=./.env

# ── Content lifetimes ────────────────────────────────────────────────
# Access-code lifetime in milliseconds (default: 60000 = 1 minute).
CONTENT_EXPIRY_MS=60000
# Expiry-sweep cadence in milliseconds (default: 30000 = 30 seconds).
CONTENT_CLEANUP_INTERVAL_MS=30000

# ── Join gate ────────────────────────────────────────────────────────
# One-time invite-link lifespan in seconds (default: 3600 = 1 hour).
GATE_INVITE_LINK_TTL_SEC=3600
# Global fallback-link rotation cadence in milliseconds (default: 3600000 = 1 hour).
GATE_LINK_REFRESH_MS=3600000
# Pending gate-confirm window in milliseconds (default: 600000 = 10 minutes).
GATE_CONFIRM_TTL_MS=600000
# Chats required by the join gate (JSON array of numeric chat ids).
# Managed AUTOMATICALLY by the bot — leave empty, do not hand-edit.
REQUIRED_CHAT_IDS=[]
# GLOBAL fallback invite links, one per REQUIRED_CHAT_IDS entry (index-parallel).
# Managed AUTOMATICALLY by the bot — leave empty, do not hand-edit.
REQUIRED_CHAT_GLOBAL_LINKS=[]

# ── Scheduled DB snapshots (disabled by default) ─────────────────────
BACKUP_ENABLED=false
# Snapshot format: tar.gz (single uploadable file) or dir (raw LMDB dir).
BACKUP_FORMAT=tar.gz
# Snapshot output directory (must be dedicated — pruning counts everything inside).
BACKUP_DIR=./backups
# Snapshot cadence in milliseconds (default: 86400000 = 24 hours).
BACKUP_INTERVAL_MS=86400000
# How many recent snapshots to retain (default: 3).
BACKUP_KEEP=3

# ── S3-compatible backup upload (off by default) ─────────────────────
# Works with Cloudflare R2, AWS S3, MinIO.
BACKUP_S3_ENABLED=false
# API endpoint (R2/MinIO URL; empty = AWS default).
BACKUP_S3_ENDPOINT=
# Region (auto works for R2; set the real region for AWS).
BACKUP_S3_REGION=auto
# Bucket name (required when S3 upload is enabled).
BACKUP_S3_BUCKET=
# Key prefix for uploaded archives.
BACKUP_S3_PREFIX=vip-content-bot/
# Credentials (required when S3 upload is enabled) — never commit.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# true for MinIO-style path URLs.
BACKUP_S3_FORCE_PATH_STYLE=false
# Remote archives to retain (blank = follow BACKUP_KEEP).
BACKUP_S3_KEEP=
