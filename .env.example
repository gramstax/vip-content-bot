# VIP Content Bot — environment template.
# Copy to `.env` and fill the required values. Never commit a real `.env`.
#
# REQUIRED means the bot refuses to boot without it.
# Everything else falls back to the default shown here.

# ── Telegram (REQUIRED) ──────────────────────────────────────────────
# Talk to @BotFather, paste the token. Revoked/bad tokens fail at boot (401).
TELEGRAM_BOT_TOKEN=
# polling | webhook:<public-url> | serverless:<adapter>
TELEGRAM_BOT_DEPLOY=polling
# JSON array of NUMERIC admin Telegram user IDs (numbers, not strings).
# Only these users can upload content and open /admin.
BOT_ADMIN_IDS=[]

# ── Sessions & paths ─────────────────────────────────────────────────
# memory (single instance) or redis:<url> (multi-instance).
TELEGRAM_CACHE_SESSION=memory
# LMDB data directory (created at runtime, never commit).
DB_PATH=./data
# Log file directory (used when file logging is enabled).
LOGS_DIR=./logs
# Project-root .env — the bot rewrites gate state here, no restart needed.
GATE_ENV_PATH=./.env

# ── Content lifetimes (milliseconds unless noted) ────────────────────
# How fast a fresh access code burns.
CONTENT_EXPIRY_MS=60000
# How often the background worker sweeps expired content.
CONTENT_CLEANUP_INTERVAL_MS=30000

# ── Join gate ────────────────────────────────────────────────────────
# Managed AUTOMATICALLY by the bot (promote it to admin, tap Add) —
# leave empty, do not hand-edit.
REQUIRED_CHAT_IDS=[]
REQUIRED_CHAT_GLOBAL_LINKS=[]
# One-time invite-link lifespan, in seconds.
GATE_INVITE_LINK_TTL_SEC=3600
# Global-link rotation cadence, in milliseconds.
GATE_LINK_REFRESH_MS=3600000
# Pending gate-confirm expiry, in milliseconds (10 min).
GATE_CONFIRM_TTL_MS=600000

# ── Backups (off by default) ─────────────────────────────────────────
BACKUP_ENABLED=false
# tar.gz (single uploadable file) or dir (raw LMDB dir).
BACKUP_FORMAT=tar.gz
# Dedicated directory for timestamped snapshots (must be dedicated).
BACKUP_DIR=./backups
# Snapshot cadence, in milliseconds (24 h).
BACKUP_INTERVAL_MS=86400000
# How many recent snapshots to retain.
BACKUP_KEEP=3

# ── S3-compatible upload (Cloudflare R2, AWS S3, MinIO) ──────────────
BACKUP_S3_ENABLED=false
# API endpoint (R2/MinIO URL; empty = AWS default).
BACKUP_S3_ENDPOINT=
# Region (auto works for R2; set the real region for AWS).
BACKUP_S3_REGION=auto
# Bucket name (required when S3 upload is enabled).
BACKUP_S3_BUCKET=
# Key prefix for uploaded archives.
BACKUP_S3_PREFIX=vip-content-bot/
# Credentials (required when S3 upload is enabled) — never commit.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# true for MinIO-style path URLs.
BACKUP_S3_FORCE_PATH_STYLE=false
# Remote archives to retain (blank = follow BACKUP_KEEP).
BACKUP_S3_KEEP=
